# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/
.env

# Data (heavy / regenerable). Keep folder structure via .gitkeep.
data/raw/*
data/interim/*
data/processed/*
