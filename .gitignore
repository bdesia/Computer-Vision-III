data/processed/sam_gt/*
!data/processed/sam_gt/*.png
!data/processed/sam_gt/README.md

# Model weights and generated volumes
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
*.tif
*.tiff

# Logs
logs/*
!logs/.gitkeep

# Hugging Face cache (if redirected locally)
.hf_cache/

